# IdeaFlow Environment Variables
# Copy to .env and fill in values. NEVER commit .env

# ── Anthropic ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── App ────────────────────────────────────────────
NODE_ENV=development
PORT=3001
JWT_SECRET=your-super-secret-key-min-32-chars

# ── Database ───────────────────────────────────────
# DEV: SQLite (auto-created, no config needed)
SQLITE_PATH=./data/ideaflow.db

# PROD: MongoDB Atlas (leave empty for local dev)
MONGODB_URI=mongodb+srv://...

# ── Frontend ───────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ── Optional: Voice ────────────────────────────────
# Default voice language (de-DE or en-US)
DEFAULT_VOICE_LANG=de-DE
